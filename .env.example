# Clerk identity
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_me
CLERK_SECRET_KEY=sk_test_replace_me
CLERK_WEBHOOK_SIGNING_SECRET=whsec_replace_me
CLERK_ISSUER_DOMAIN=your-clerk-domain.clerk.accounts.dev

# Local Supabase defaults; replace with hosted EU values for staging/production.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace_with_supabase_publishable_key
SUPABASE_SERVICE_ROLE_KEY=replace_with_server_only_service_role_key

# GoCardless Bank Account Data (EU/EEA Open Banking)
GOCARDLESS_BANK_DATA_BASE_URL=https://bankaccountdata.gocardless.com
GOCARDLESS_BANK_DATA_SECRET_ID=replace_me
GOCARDLESS_BANK_DATA_SECRET_KEY=replace_me
ABI_VAULT_ENABLE_BANK_RUNTIME=false
NEXT_PUBLIC_ABI_VAULT_LOCAL_MODE=false
NEXT_PUBLIC_APP_URL=http://localhost:3000
CRON_SECRET=replace_with_a_long_random_value

# Server-side 32-byte hex key for provider tokens and sensitive account metadata.
APP_ENCRYPTION_KEY=replace_with_64_hex_characters
